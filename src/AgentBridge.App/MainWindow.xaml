<Window x:Class="AgentBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Agent Bridge" Icon="Assets/AgentBridgeLogo.png" Width="1180" Height="760" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding StartCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PauseCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding StopCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,10" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Agent Bridge" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Supervised Claude ↔ Codex control surface" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                    <TextBlock Text="STATE" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" automation:AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="ITERATION" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding IterationText}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="GENERATED" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding GeneratedText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel>
                <Border DockPanel.Dock="Left" Background="{DynamicResource ModeBrush}" CornerRadius="2" Padding="8,3" Margin="0,0,12,0">
                    <TextBlock Text="{Binding ModeText}" Foreground="White" FontSize="11" FontWeight="Bold" />
                </Border>
                <TextBlock Text="{Binding ModeExplanation}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource NavigationBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <TextBlock Text="PROJECT" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding ProjectPath}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <StackPanel>
                        <Button Style="{StaticResource NavButton}" Content="▣  Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />
                        <Button Style="{StaticResource NavButton}" Content="≡  Activity" Command="{Binding NavigateCommand}" CommandParameter="Activity" />
                        <Button Style="{StaticResource NavButton}" Content="◇  Diagnostics" Command="{Binding NavigateCommand}" CommandParameter="Diagnostics" />
                        <Button Style="{StaticResource NavButton}" Content="□  Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                        <Button Style="{StaticResource NavButton}" Content="○  Setup" Command="{Binding NavigateCommand}" CommandParameter="Setup" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
                <Grid>
                    <!-- Dashboard -->
                    <StackPanel Visibility="{Binding IsDashboard, Converter={StaticResource BooleanToVisibility}}">
                        <Border Style="{StaticResource PanelStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Resume checkpoint" Style="{StaticResource Caption}" />
                                    <ComboBox ItemsSource="{Binding StartPointOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedStartPoint}"
                                              IsEnabled="{Binding CanStart}"
                                              MinHeight="32"
                                              automation:AutomationProperties.Name="Resume checkpoint" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Choose who is currently working before you press Start." FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedStartPointDescription}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="▶ Start" Command="{Binding StartCommand}" automation:AutomationProperties.HelpText="Starts or safely resumes the bridge." />
                            <Button Content="Ⅱ Pause" Command="{Binding PauseCommand}" automation:AutomationProperties.HelpText="Pauses processing while keeping the current iteration." />
                            <Button Content="▶ Resume" Command="{Binding ResumeCommand}" />
                            <Button Content="↻ Retry Codex" Command="{Binding RetryCodexCommand}" automation:AutomationProperties.HelpText="Resends the current Claude report instruction to Codex without resetting iteration progress." />
                            <Button Content="↻ Retry Claude" Command="{Binding RetryClaudeCommand}" automation:AutomationProperties.HelpText="Resends the current Codex instruction to Claude without resetting iteration progress." />
                            <Button Content="▸ Continue Claude" Command="{Binding ContinueClaudeCommand}" automation:AutomationProperties.HelpText="Asks Claude to carry on with the session it was already having, without resending the instruction." />
                            <Button Content="▸ Continue Codex" Command="{Binding ContinueCodexCommand}" automation:AutomationProperties.HelpText="Asks Codex to carry on with the session it was already having, without resending the instruction." />
                            <Button Content="⟲ Recover Claude" Command="{Binding RecoverClaudeCommand}" automation:AutomationProperties.HelpText="Use after a shutdown or crash. Tells Claude its run was cut short, so it checks the repository for what actually got done before finishing the task." />
                            <Button Content="⟲ Recover Codex" Command="{Binding RecoverCodexCommand}" automation:AutomationProperties.HelpText="Use after a shutdown or crash. Tells Codex its run was cut short, so it checks the repository before finishing its review." />
                            <Button Content="■ Stop" Command="{Binding StopCommand}" Foreground="{DynamicResource ErrorBrush}" />
                            <Button Content="↻ Refresh" Command="{Binding RefreshCommand}" />
                            <Button Content="Reset state…" Command="{Binding ResetStateCommand}"
                                    Foreground="{DynamicResource ErrorBrush}"
                                    automation:AutomationProperties.HelpText="Discards the iteration counter and the recorded protocol-file hashes so the current files count as new again. Available while the bridge is stopped." />
                        </StackPanel>

                        <Border Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Drive Claude from another device" FontWeight="SemiBold" />
                                <TextBlock Text="Opens a Claude session carrying a copy of this project's conversation and shows the link to open on a phone or another machine. It runs alongside the loop — what you do there does not disturb the run."
                                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="⇱ Remote control" Command="{Binding OpenRemoteControlCommand}"
                                            automation:AutomationProperties.HelpText="Starts a background Claude session with Remote Control enabled and shows the link it publishes." />
                                </StackPanel>
                                <TextBlock Text="{Binding RemoteControlStatus}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" />
                                <TextBox Text="{Binding RemoteControlUrl, Mode=OneWay}"
                                         Visibility="{Binding HasRemoteControlUrl, Converter={StaticResource BooleanToVisibility}}"
                                         IsReadOnly="True" FontFamily="Consolas" Margin="0,8,0,0"
                                         automation:AutomationProperties.Name="Remote control link" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelStyle}" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}" BorderBrush="{DynamicResource ErrorBrush}" Background="{DynamicResource ErrorSurfaceBrush}" automation:AutomationProperties.LiveSetting="Assertive">
                            <StackPanel>
                                <TextBlock Text="The loop needs attention" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ErrorBrush}" />
                                <TextBlock Text="{Binding LastErrorText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Open Diagnostics" Command="{Binding NavigateCommand}" CommandParameter="Diagnostics" />
                                    <Button Content="Continue waiting for Claude" Command="{Binding ContinueWaitingForClaudeCommand}" />
                                    <Button Content="Continue waiting for Codex" Command="{Binding ContinueWaitingForCodexCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Cycle position" Style="{StaticResource SectionTitle}" />
                                <UniformGrid Columns="8">
                                    <TextBlock Text="Claude report" TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Text="Report detected" TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Text="Codex handoff" TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Text="Waiting Codex" TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Text="Codex processing" TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Text="Prompt detected" TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Text="Claude handoff" TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Text="Claude processing" TextAlignment="Center" TextWrapping="Wrap" />
                                </UniformGrid>
                                <ProgressBar Minimum="0" Maximum="8" Value="{Binding CycleProgress, Mode=OneWay}" Height="8" Margin="0,12,0,0" Foreground="{DynamicResource AccentBrush}" IsHitTestVisible="False" automation:AutomationProperties.Name="Cycle progress" />
                                <TextBlock Text="{Binding CycleProgressText}" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Status" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Status.StatusText}" TextWrapping="Wrap" Margin="0,4,0,12" />
                                    <TextBlock Text="LAST ACTION" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding LastActionText}" Style="{StaticResource ValueText}" />
                                    <TextBlock Text="LAST ERROR" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding LastErrorText}" Style="{StaticResource ValueText}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Git" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="BRANCH" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding GitBranchText}" Style="{StaticResource ValueText}" FontFamily="Cascadia Mono, Consolas" />
                                    <TextBlock Text="WORKING TREE" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding GitTreeText}" Style="{StaticResource ValueText}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Agents" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="CLAUDE DESKTOP" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding ClaudeStatusText}" Style="{StaticResource ValueText}" />
                                    <TextBlock Text="CHATGPT DESKTOP (CODEX)" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding CodexStatusText}" Style="{StaticResource ValueText}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Protocol files" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="ClaudeResultReport.md" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding ClaudeFileUpdateText}" Style="{StaticResource ValueText}" />
                                    <TextBlock Text="CodexPrompt.md" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding CodexFileUpdateText}" Style="{StaticResource ValueText}" />
                                    <TextBlock Text="File contents are never shown here." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Activity -->
                    <StackPanel Visibility="{Binding IsActivity, Converter={StaticResource BooleanToVisibility}}">
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Activity" FontSize="20" FontWeight="SemiBold" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox Content="Follow" IsChecked="{Binding FollowActivity}" VerticalAlignment="Center" Margin="0,0,12,0"
                                          automation:AutomationProperties.HelpText="Keeps reloading the newest entries. Turn it off to scroll back without the list jumping." />
                                <Button Content="Refresh" Command="{Binding LoadActivityCommand}" />
                                <Button Content="Export…" Command="{Binding ExportActivityCommand}"
                                        automation:AutomationProperties.HelpText="Writes every stored log, oldest first, to one file." />
                                <Button Content="Clear view" Command="{Binding ClearActivityCommand}"
                                        automation:AutomationProperties.HelpText="Empties this list so the next step is easy to watch. The log files are untouched; Refresh brings them back." />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="Prompt and report bodies are redacted from application logs." Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,12" />
                        <DataGrid ItemsSource="{Binding ActivityEntries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="420"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <!-- A wrapped message makes rows tall and uneven, so the row has to
                                         grow to its content rather than to a fixed line height. -->
                                    <Setter Property="VerticalContentAlignment" Value="Top" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Local time" Binding="{Binding TimestampLocal, StringFormat={}{0:HH:mm:ss}}" Width="80" />
                                <DataGridTextColumn Header="Severity" Binding="{Binding Level}" Width="80" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="160" />
                                <!-- A text column truncates at the column edge, which is what made a
                                     streamed agent line unreadable: the interesting part is past the
                                     cut. A template cell can wrap, so the whole line is on screen. -->
                                <DataGridTemplateColumn Header="Message" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="2,3"
                                                       FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <!-- Diagnostics -->
                    <StackPanel Visibility="{Binding IsDiagnostics, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="Agent diagnostics" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Claude Desktop" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding ClaudeDiagnostics}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" Margin="0,0,0,12" />
                                    <Button Content="Test connection" Command="{Binding TestClaudeCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="ChatGPT Desktop (Codex)" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding CodexDiagnostics}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" Margin="0,0,0,12" />
                                    <Button Content="Test connection" Command="{Binding TestCodexCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource PanelStyle}" Background="{DynamicResource WarningSurfaceBrush}">
                            <TextBlock Text="Diagnostics are read-only. Live delivery requires an exact active-conversation title, a unique semantic input and Send control, and a verified rendered receipt." TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <!-- Settings -->
                    <StackPanel Visibility="{Binding IsSettings, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Project and protocol files" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="PROJECT FOLDER" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10" />
                                    <TextBlock Text="CLAUDE REPORT FILE" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding ClaudeReportFileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10" />
                                    <TextBlock Text="CODEX PROMPT FILE" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding CodexPromptFileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Automation safety" Style="{StaticResource SectionTitle}" />
                                    <CheckBox IsChecked="{Binding DryRun}" Content="Dry Run — simulate delivery only" Margin="0,0,0,10" />
                                    <TextBlock Text="CLAUDE ACTIVE CONVERSATION TITLE" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding ClaudeConversationIdentifier, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding UseClaudeDesktop}"
                                             Margin="0,3,0,10" />
                                    <TextBlock Text="HOW CLAUDE IS DRIVEN" Style="{StaticResource Caption}" />
                                    <RadioButton GroupName="ClaudeTransport" Content="Claude Desktop window"
                                                 IsChecked="{Binding UseClaudeDesktop}"
                                                 Margin="0,6,0,4" />
                                    <RadioButton GroupName="ClaudeTransport" Content="Claude CLI (claude --print)"
                                                 IsChecked="{Binding UseClaudeCli}" Margin="0,0,0,6" />
                                    <TextBlock Text="The CLI needs `npm install -g @anthropic-ai/claude-code` and a signed-in session. It has no window to find, so the conversation title above does not apply to it, and it keeps working while Windows is locked."
                                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" />
                                    <TextBlock Text="CODEX ACTIVE CONVERSATION TITLE" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding CodexConversationIdentifier, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding UseCodexDesktop}"
                                             Margin="0,3,0,10" />
                                    <TextBlock Text="HOW CODEX IS DRIVEN" Style="{StaticResource Caption}" />
                                    <RadioButton GroupName="CodexTransport" Content="ChatGPT Desktop window"
                                                 IsChecked="{Binding UseCodexDesktop}"
                                                 Margin="0,6,0,4" />
                                    <RadioButton GroupName="CodexTransport" Content="Codex CLI (codex exec)"
                                                 IsChecked="{Binding UseCodexCli}" Margin="0,0,0,6" />
                                    <TextBlock Text="The CLI needs `npm install -g @openai/codex` and a signed-in session. It has no window to find, so the conversation title above does not apply to it."
                                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" />
                                    <TextBlock Text="Clearing Dry Run requires a confirmation when settings are saved, and an exact conversation title for each agent still driven through its desktop window. Settings cannot be changed during an active run." TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                                <Grid Grid.IsSharedSizeScope="True">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Labels" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Text="Maximum iterations" VerticalAlignment="Center" Margin="0,0,16,8" />
                                    <TextBox Grid.Column="1" Text="{Binding MaximumIterations}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="1" Text="Step timeout (seconds)" VerticalAlignment="Center" Margin="0,0,16,8" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AgentTimeoutSeconds}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="2" Text="Retries per step" VerticalAlignment="Center" Margin="0,0,16,8" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RetryCount}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="3" Text="File debounce (ms)" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FileDebounceMilliseconds}" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Notifications and startup" Style="{StaticResource SectionTitle}" />
                                    <CheckBox IsChecked="{Binding NotificationsEnabled}" Content="Enable Windows notifications" Margin="0,0,0,10" />
                                    <CheckBox IsChecked="{Binding AutoStart}" Content="Start the bridge automatically when the app opens" Margin="0,0,0,10" />
                                    <CheckBox IsChecked="{Binding StartMinimized}" Content="Start minimized" Margin="0,0,0,10" />
                                    <CheckBox IsChecked="{Binding DarkTheme}" Content="Use dark theme" Margin="0,0,0,12" />

                                    <TextBlock Text="TELEGRAM" Style="{StaticResource Caption}" />
                                    <CheckBox IsChecked="{Binding TelegramNotificationsEnabled}" Content="Send notifications to a Telegram chat" Margin="0,4,0,8" />
                                    <TextBlock Text="BOT TOKEN (from @BotFather)" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding TelegramBotToken, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8" />
                                    <TextBlock Text="CHAT ID (a number, or @channelname)" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8" />
                                    <CheckBox IsChecked="{Binding TelegramIncludeReports}" Content="Attach the full report file to each message" Margin="0,0,0,8" />
                                    <Button Content="Send test message" Command="{Binding TestTelegramCommand}" HorizontalAlignment="Left"
                                            automation:AutomationProperties.HelpText="Sends a test message using the saved token and chat id. Save first." />
                                    <TextBlock Text="{Binding TelegramTestResult}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,12" />
                                    <TextBlock Text="To find your chat id: message the bot once, then open https://api.telegram.org/bot&lt;token&gt;/getUpdates and read chat.id. The test uses the saved values, so Save before testing." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12" />

                                    <TextBlock Text="Settings are validated and written as a single transaction. A partial save cannot occur." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                                <StackPanel IsEnabled="{Binding UseClaudeCli}">
                                    <TextBlock Text="Claude CLI" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="EXECUTABLE" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding ClaudeCliExecutable, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10" />
                                    <TextBlock Text="ARGUMENTS FOR ONE RUN" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding ClaudeCliArguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,6" />
                                    <TextBlock Text="--print makes the run non-interactive; with no prompt argument the instruction is written to standard input. An unattended run has nobody to answer a permission prompt, so a run that has to ask produces no report: use --dangerously-skip-permissions if the loop must build and test on its own. Add --verbose --output-format stream-json to see Claude's progress in Activity as it happens."
                                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" />
                                    <TextBlock Text="RUN TIMEOUT (SECONDS)" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding ClaudeCliTimeoutSeconds}" Margin="0,3,0,10" />
                                    <TextBlock Text="REMOTE CONTROL SESSION NAME" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding RemoteControlSessionName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"
                                             automation:AutomationProperties.HelpText="What a session opened from the dashboard is called, so it is recognisable among your other sessions rather than named after this machine." />
                                    <TextBlock Text="AGENT LOG LINE LIMIT (0 = NO LIMIT)" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding AgentLogLineLimit}" Margin="0,3,0,10"
                                             automation:AutomationProperties.HelpText="Lines of one agent run written to the log before the rest is kept for diagnostics only. A run that executes a test suite can print far more than the default." />

                                    <TextBlock Text="AGENT ENVIRONMENT (ONE KEY=VALUE PER LINE)" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding AgentEnvironment, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,4"
                                             AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="60" VerticalScrollBarVisibility="Auto"
                                             FontFamily="Consolas"
                                             automation:AutomationProperties.HelpText="Extra environment variables for every agent process. Empty changes nothing." />
                                    <TextBlock Text="Applies to both agents. On a machine behind a local proxy: NODE_OPTIONS=--use-env-proxy and PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false spare the agents from rediscovering these each run."
                                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                                <StackPanel IsEnabled="{Binding UseCodexCli}">
                                    <TextBlock Text="Codex CLI" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="EXECUTABLE" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding CodexCliExecutable, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10" />
                                    <TextBlock Text="ARGUMENTS FOR ONE RUN" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding CodexCliArguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,6" />
                                    <TextBlock Text="The trailing &quot;-&quot; is what makes Codex read the instruction from standard input, which is what lets a long multi-line prompt through without quoting. Keep it."
                                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" />
                                    <TextBlock Text="RUN TIMEOUT (SECONDS)" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding CodexCliTimeoutSeconds}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Right" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" />
                    </StackPanel>

                    <!-- Setup wizard -->
                    <StackPanel Visibility="{Binding IsSetup, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="Agent Bridge setup" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SetupStepTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,12" />
                        <UniformGrid Columns="5" Margin="0,0,12,16">
                            <TextBlock Text="1  Safety" TextAlignment="Center" />
                            <TextBlock Text="2  Project" TextAlignment="Center" />
                            <TextBlock Text="3  Protocol" TextAlignment="Center" />
                            <TextBlock Text="4  Readiness" TextAlignment="Center" />
                            <TextBlock Text="5  Review" TextAlignment="Center" />
                        </UniformGrid>
                        <ProgressBar Minimum="1" Maximum="5" Value="{Binding SetupStep, Mode=OneWay}" Height="5" Margin="0,0,12,16" />

                        <Border Style="{StaticResource PanelStyle}" Visibility="{Binding IsSetupWelcome, Converter={StaticResource BooleanToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Welcome and safety" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Agent Bridge coordinates a supervised file-based loop between Claude and Codex. This setup validates your project without changing it." TextWrapping="Wrap" Margin="0,0,0,12" />
                                <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" Padding="12">
                                    <TextBlock Text="Dry Run is enabled by default and sends no desktop input. Live mode must be configured and confirmed separately in Settings." TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelStyle}" Visibility="{Binding IsSetupProject, Converter={StaticResource BooleanToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Project folder" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseProjectCommand}" Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock Text="Validation is read-only. A Git repository is recommended but not required." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelStyle}" Visibility="{Binding IsSetupProtocol, Converter={StaticResource BooleanToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Protocol files" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="CLAUDE REPORT FILE" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding ClaudeReportFileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10" />
                                <TextBlock Text="CODEX PROMPT FILE" Style="{StaticResource Caption}" />
                                <TextBox Text="{Binding CodexPromptFileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10" />
                                <TextBlock Text="Only simple filenames in the project root are accepted. Missing files are allowed and may be created later by the agents." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelStyle}" Visibility="{Binding IsSetupAgents, Converter={StaticResource BooleanToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Desktop readiness" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Claude Desktop" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ClaudeDiagnostics}" TextWrapping="Wrap" Margin="0,3,0,12" />
                                <TextBlock Text="ChatGPT Desktop (Codex)" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CodexDiagnostics}" TextWrapping="Wrap" Margin="0,3,0,12" />
                                <Border Background="{DynamicResource WarningSurfaceBrush}" Padding="12">
                                    <TextBlock Text="These probes are read-only. Configure exact active-conversation titles in Settings before considering Live mode." TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelStyle}" Visibility="{Binding IsSetupReview, Converter={StaticResource BooleanToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Review and finish" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="PROJECT" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding ProjectPath}" Style="{StaticResource ValueText}" />
                                <TextBlock Text="PROTOCOL" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding ClaudeReportFileName}" />
                                <TextBlock Text="{Binding CodexPromptFileName}" Margin="0,2,0,10" />
                                <TextBlock Text="MODE" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding ModeText}" Style="{StaticResource ValueText}" />
                                <TextBlock Text="Finishing saves all settings atomically. If validation fails, nothing is written." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="12" Margin="0,0,12,12">
                            <TextBlock Text="{Binding SetupValidation}" TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Polite" />
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                            <Button Content="Back" Command="{Binding SetupBackCommand}" />
                            <Button Content="{Binding SetupNextText}" Command="{Binding SetupNextCommand}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <TextBlock Text="Service connected" Foreground="{DynamicResource VerifiedBrush}" DockPanel.Dock="Left" />
                <TextBlock Text="{Binding OperationMessage}" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
